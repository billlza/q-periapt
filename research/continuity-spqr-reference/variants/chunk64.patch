diff --git a/src/lib.rs b/src/lib.rs
index 7c3076f..e677a20 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -1134 +1134 @@ mod lib_test {
-        // EncapsState serialization prior to libcrux:pr/1276, 30 steps into a lockstep
+        // EncapsState serialization prior to libcrux:pr/1276, 8 steps into the 64-byte lockstep
@@ -1139,2 +1139,2 @@ mod lib_test {
-        let mut alex_pq_state = include_bytes!("issue1275_a_state.in").to_vec();
-        let mut blake_pq_state = include_bytes!("issue1275_b_state.in").to_vec();
+        let mut alex_pq_state = include_bytes!("issue1275_chunk64_a_state.in").to_vec();
+        let mut blake_pq_state = include_bytes!("issue1275_chunk64_b_state.in").to_vec();
@@ -1142 +1142 @@ mod lib_test {
-        // After 20 additional steps, we should be in epoch 2 successfully.  If
+        // After 52 additional steps, both directions must have reached epoch 2. If
@@ -1144 +1144 @@ mod lib_test {
-        for i in 30..50 {
+        for i in 8..60 {
@@ -1170,0 +1171,4 @@ mod lib_test {
+        for state in [alex_pq_state, blake_pq_state] {
+            let decoded = pqrpb::PqRatchetState::decode(state.as_slice()).map_err(|_| Error::StateDecode)?;
+            assert!(decoded.chain.ok_or(Error::ChainNotAvailable)?.current_epoch >= 2);
+        }
@@ -1172,0 +1177,9 @@ mod lib_test {
+
+    #[test]
+    fn chunk64_rejects_original_chunk32_regression_states() {
+        let mut rng = OsRng.unwrap_err();
+        for state in [include_bytes!("issue1275_a_state.in").to_vec(),
+                      include_bytes!("issue1275_b_state.in").to_vec()] {
+            assert!(matches!(send(&state, &mut rng), Err(Error::StateDecode)));
+        }
+    }
