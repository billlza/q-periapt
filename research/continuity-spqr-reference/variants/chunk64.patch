diff --git a/examples/chunk64_regression_fixture.rs b/examples/chunk64_regression_fixture.rs
new file mode 100644
index 0000000..ba59a52
--- /dev/null
+++ b/examples/chunk64_regression_fixture.rs
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+//! Public deterministic fixture generator for the isolated 64-byte experiment.
+use prost::Message;
+use rand::{rngs::StdRng, SeedableRng};
+use spqr::{proto::pq_ratchet as pb, ChainParams, Direction, Params, Version};
+use std::{error::Error, fs::File, io::{self, Write}, path::Path};
+
+fn main() -> Result<(), Box<dyn Error>> {
+    let output = std::env::args_os().nth(1).ok_or_else(|| io::Error::other("output directory required"))?;
+    let output = Path::new(&output);
+    if spqr::encoding::polynomial::NUM_POLYS != 32 {
+        return Err(io::Error::other("64-byte experiment required").into());
+    }
+    let initial = |direction| spqr::initial_state(Params {
+        direction, version:Version::V1, min_version:Version::V1,
+        auth_key:&[41;32], chain_params:ChainParams::default(),
+    });
+    let mut a = initial(Direction::A2B)?;
+    let mut b = initial(Direction::B2A)?;
+    let mut rng = StdRng::seed_from_u64(0x3634495353554531);
+    for _ in 0..8 {
+        let sent = spqr::send(&a,&mut rng)?;
+        a = sent.state;
+        let received = spqr::recv(&b,&sent.msg)?;
+        if sent.key != received.key { return Err(io::Error::other("A key mismatch").into()); }
+        b = received.state;
+        let sent = spqr::send(&b,&mut rng)?;
+        b = sent.state;
+        let received = spqr::recv(&a,&sent.msg)?;
+        if sent.key != received.key { return Err(io::Error::other("B key mismatch").into()); }
+        a = received.state;
+    }
+    let mut decoded = pb::PqRatchetState::decode(b.as_slice())?;
+    let Some(pb::pq_ratchet_state::Inner::V1(inner)) = decoded.inner.as_mut() else {
+        return Err(io::Error::other("missing v1 state").into());
+    };
+    let Some(pb::v1_state::InnerState::Ct1Sampled(sampled)) = inner.inner_state.as_mut() else {
+        return Err(io::Error::other("fixture is not before encapsulate2").into());
+    };
+    let es = &mut sampled.uc.as_mut().ok_or_else(|| io::Error::other("missing encapsulation state"))?.es;
+    if es.len() != 2080 { return Err(io::Error::other("encapsulation state size").into()); }
+    let errors = es.get(1536..2048).ok_or_else(|| io::Error::other("error polynomial missing"))?;
+    let errors:Vec<i16> = errors.chunks_exact(2).map(|p| i16::from_le_bytes([p[0],p[1]])).collect();
+    if !errors.iter().all(|v| (-2..=2).contains(v)) || !errors.iter().any(|v| matches!(v,1|2|-2)) {
+        return Err(io::Error::other("fixture does not distinguish the legacy byte order").into());
+    }
+    for pair in es.get_mut(..2048).ok_or_else(|| io::Error::other("encoded state missing"))?.chunks_exact_mut(2) {
+        pair.swap(0,1);
+    }
+    b = decoded.encode_to_vec();
+    for (name,bytes) in [("issue1275_chunk64_a_state.in",a),("issue1275_chunk64_b_state.in",b)] {
+        let mut file=File::create_new(output.join(name))?;
+        file.write_all(&bytes)?;
+        file.sync_all()?;
+    }
+    Ok(())
+}
