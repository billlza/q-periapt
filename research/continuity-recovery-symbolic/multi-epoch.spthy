theory ContinuityMultiEpochRecoveryProjection
begin

/* Unbounded alternating rounds with inherited roots and transcript parents.
   The stable session/context and local confirmed epoch survive each round.
   Perfect cryptography, atomic phase writes and per-record capture remain
   abstractions. Initial traffic, receive chains, history retirement, witness
   admission, concrete serialization and crash refinement are not established. */
builtins: hashing, signing, symmetric-encryption
functions: kempk/1, kemct/2, decap/2, succ/1, scope/6
equations: decap(x,kemct(kempk(x),y)) = y

rule Identity_Key:
 [ Fr(~signer) ] --[ SigningSecret(~signer) ]->
 [ !IdentityKey(~signer), Out(pk(~signer)) ]

rule Storage_Key:
 [ Fr(~wrapping) ] --> [ !StorageKey(~wrapping) ]

/* CounterState observes the counter of every produced SendState. Removing
   these seven action facts preserves all original executions and queries. */
rule Setup:
 let parent = h(<'genesis',~sid,context>)
 in
 [ !IdentityKey(sa)[no_precomp], !IdentityKey(sb)[no_precomp], !StorageKey(wa)[no_precomp], !StorageKey(wb)[no_precomp]
 , In(context), Fr(~sid), Fr(~old) ]
 --[ Setup(~sid), SessionKeys(~sid,sa,sb), SessionStorage(~sid,wa,wb)
   , ReadyState(~sid,'A','zero',~old,parent), ReadyState(~sid,'B','zero',~old,parent)
   , CounterState(~sid,'A','zero','zero'), CounterState(~sid,'B','zero','zero') ]->
 [ !Context(~sid,context), !Signer(~sid,'A',sa), !Signer(~sid,'B',sb)
 , !Pinned(~sid,'A',pk(sa)), !Pinned(~sid,'B',pk(sb))
 , !Wrap(~sid,'A',wa), !Wrap(~sid,'B',wb)
 , !SignerFile(~sid,'A',sa), !SignerFile(~sid,'B',sb)
 , !Peers(~sid,'A','B'), !Peers(~sid,'B','A')
 , Ready(~sid,'A','zero',parent,~old,'A')
 , Ready(~sid,'B','zero',parent,~old,'A')
 , SendState(~sid,'A','zero',~old,'initial-offer','initial-response','zero')
 , SendState(~sid,'B','zero',~old,'initial-offer','initial-response','zero')
 , SendPermit(~sid,'A'), SendPermit(~sid,'B'), CutPermit(~sid)
 , Out(<~sid,context,~old,pk(sa),pk(sb)>) ]

rule Cut:
 [ CutPermit(s)[no_precomp], !Wrap(s,'A',wa)[no_precomp], !Wrap(s,'B',wb)[no_precomp] ]
 --[ Cut(s), WrappingKeyLeak(wa), WrappingKeyLeak(wb) ]-> [ Out(<wa,wb>) ]

rule Snapshot:
 [ !Stored(s,role,epoch,phase,revision,plaintext)[no_precomp], !Wrap(s,role,wrapping)[no_precomp] ]
 --[ Snapshot(s,role,epoch,revision), CapturedPhase(s,role,epoch,phase) ]->
 [ Out(senc(<'record',s,role,epoch,phase,revision,plaintext>,wrapping)) ]

rule Reveal_Identity:
 [ !Signer(s,role,key)[no_precomp] ] --[ IdentityLeak(s,role), IdentityKeyLeak(key) ]-> [ Out(key) ]

rule Snapshot_Signer_File:
 [ !SignerFile(s,role,key)[no_precomp], !Wrap(s,role,wrapping)[no_precomp] ]
 --[ IdentityLeak(s,role), IdentityKeyLeak(key), SignerFileCaptured(s,role) ]->
 [ Out(senc(<'signer',s,role,key>,h(<'signing-owner',wrapping>))) ]

rule Reveal_Entropy:
 [ !Entropy(s,epoch,kind,coins)[no_precomp] ]
 --[ EntropyLeak(s,epoch,kind) ]-> [ Out(coins) ]

rule Key_Reservation_1:
 let epoch = succ(n)
 in
 [ Ready(s,p,n,parent,old,p)[no_precomp], !Wrap(s,p,wrapping)[no_precomp], Fr(~key), Fr(~rev) ]
 --[ KeyReserved(s,epoch,p), GenerationSecret(s,epoch,~key)
   , RootBefore(s,p,epoch,old,parent), Saved(s,p,epoch,~rev,'1') ]->
 [ Offer1(s,p,n,parent,old,~key), !Entropy(s,epoch,'generation',~key)
 , !Stored(s,p,epoch,'1',~rev,<n,parent,old,~key>) ]

rule Offer_Signing_2:
 [ Offer1(s,p,n,parent,old,key)[no_precomp], !Wrap(s,p,wrapping)[no_precomp], Fr(~rev) ]
 --[ Saved(s,p,succ(n),~rev,'2') ]->
 [ Offer2(s,p,n,parent,old,key)
 , !Stored(s,p,succ(n),'2',~rev,<n,parent,old,key>) ]

rule Offer_Commit_3:
 let binding = scope(s,context,n,succ(n),p,parent)
     body = <'offer',binding,kempk(key)>
     wire = <body,sign(body,signer)>
 in
 [ Offer2(s,p,n,parent,old,key)[no_precomp], !Context(s,context)[no_precomp], !Signer(s,p,signer)[no_precomp]
 , !Wrap(s,p,wrapping)[no_precomp], Fr(~rev) ]
 --[ OfferCommitted(s,succ(n),p), Saved(s,p,succ(n),~rev,'3') ]->
 [ Offer3(s,p,n,parent,old,key,wire)
 , !Stored(s,p,succ(n),'3',~rev,<n,parent,old,key,wire>), Out(wire) ]

rule Response_Reservation_4:
 let binding = scope(s,context,n,succ(n),p,parent)
     body = <'offer',binding,peer>
     wire = <body,sig>
 in
 [ Ready(s,r,n,parent,old,p)[no_precomp], !Peers(s,p,r)[no_precomp], !Context(s,context)[no_precomp]
 , !Pinned(s,p,vk)[no_precomp], !Wrap(s,r,wrapping)[no_precomp], In(wire), Fr(~coins), Fr(~rev) ]
 --[ Eq(verify(sig,body,vk),true), EncapReserved(s,succ(n),r)
   , EncapsulationSecret(s,succ(n),peer,~coins), RootBefore(s,r,succ(n),old,parent)
   , Saved(s,r,succ(n),~rev,'4') ]->
 [ Response4(s,r,p,n,parent,old,wire,peer,~coins)
 , !Entropy(s,succ(n),'encapsulation',~coins)
 , !Stored(s,r,succ(n),'4',~rev,<n,parent,old,wire,~coins>) ]

rule Response_Compute_5:
 let binding = scope(s,context,n,succ(n),r,parent)
     core = <'response',binding,h(offer),kemct(peer,coins)>
     root = h(<'pending-root',old,coins,h(core)>)
 in
 [ Response4(s,r,p,n,parent,old,offer,peer,coins)[no_precomp], !Context(s,context)[no_precomp]
 , !Wrap(s,r,wrapping)[no_precomp], Fr(~rev) ]
 --[ ResponseRoot(s,succ(n),r,old,root), Saved(s,r,succ(n),~rev,'5') ]->
 [ Response5(s,r,p,n,parent,old,offer,core,root)
 , !Stored(s,r,succ(n),'5',~rev,<n,parent,old,offer,core,root>) ]

rule Response_Commit_6:
 let body = <core,h(<'response-confirmation',root,core>)>
     wire = <body,sign(body,signer)>
 in
 [ Response5(s,r,p,n,parent,old,offer,core,root)[no_precomp], !Signer(s,r,signer)[no_precomp]
 , !Wrap(s,r,wrapping)[no_precomp], Fr(~rev) ]
 --[ ResponseCommitted(s,succ(n),r), Saved(s,r,succ(n),~rev,'6') ]->
 [ Response6(s,r,p,n,parent,old,offer,wire,root)
 , !Stored(s,r,succ(n),'6',~rev,<n,parent,old,offer,wire,root>), Out(wire) ]

rule Final_Reservation_7:
 let response_scope = scope(s,context,n,succ(n),r,parent)
     core = <'response',response_scope,h(offer),ct>
     root = h(<'pending-root',old,decap(key,ct),h(core)>)
     response_body = <core,tag>
     response = <response_body,sig>
     final_core = <'final',scope(s,context,n,succ(n),p,parent),h(offer),h(response),closing>
     body = <final_core,h(<'final-confirmation',root,final_core>)>
 in
 [ Offer3(s,p,n,parent,old,key,offer)[no_precomp], !Peers(s,p,r)[no_precomp], !Context(s,context)[no_precomp]
 , !Pinned(s,r,vk)[no_precomp], !Wrap(s,p,wrapping)[no_precomp], In(response)
 , SendState(s,p,n,old,old_offer,old_response,closing)[+,no_precomp], SendPermit(s,p)[no_precomp], Fr(~rev) ]
 --[ Eq(verify(sig,response_body,vk),true), Eq(tag,h(<'response-confirmation',root,core>))
   , AcceptedRoot(s,succ(n),p,old,root), Saved(s,p,succ(n),~rev,'7')
   , CounterState(s,p,n,closing) ]->
 [ Final7(s,p,r,n,parent,old,offer,response,root,body,closing)
 , SendState(s,p,n,old,old_offer,old_response,closing)
 , !Stored(s,p,succ(n),'7',~rev,<n,parent,old,offer,response,root,body>) ]

rule Final_Commit_8:
 let final = <body,sign(body,signer)>
 in
 [ Final7(s,p,r,n,parent,old,offer,response,root,body,closing)[no_precomp]
 , SendState(s,p,n,old,old_offer,old_response,closing)[+,no_precomp]
 , !Signer(s,p,signer)[no_precomp], !Wrap(s,p,wrapping)[no_precomp], Fr(~rev) ]
 --[ FinalCommitted(s,succ(n),p), EpochInstalled(s,p,succ(n),root)
   , Saved(s,p,succ(n),~rev,'8'), CounterState(s,p,succ(n),'zero') ]->
 [ Final8(s,p,r,n,parent,offer,response,root,final)
 , SendState(s,p,succ(n),root,offer,response,'zero'), SendPermit(s,p)
 , !ApplicationEpoch(s,succ(n))
 , !Stored(s,p,succ(n),'8',~rev,<n,parent,root,offer,response,final>), Out(final) ]

rule Receipt_Reservation_9:
 let final_core = <'final',scope(s,context,n,succ(n),p,parent),h(offer),h(response),peer_closing>
     final_body = <final_core,tag>
     final = <final_body,sig>
     core = <'receipt',scope(s,context,n,succ(n),r,parent),h(offer),h(response),h(final),closing>
     body = <core,h(<'receipt-confirmation',root,core>)>
 in
 [ Response6(s,r,p,n,parent,old,offer,response,root)[no_precomp], !Context(s,context)[no_precomp]
 , !Pinned(s,p,vk)[no_precomp], !Wrap(s,r,wrapping)[no_precomp], In(final)
 , SendState(s,r,n,old,old_offer,old_response,closing)[+,no_precomp], SendPermit(s,r)[no_precomp], Fr(~rev) ]
 --[ Eq(verify(sig,final_body,vk),true), Eq(tag,h(<'final-confirmation',root,final_core>))
   , Saved(s,r,succ(n),~rev,'9'), CounterState(s,r,n,closing) ]->
 [ Receipt9(s,r,p,n,parent,old,offer,response,root,final,body,closing)
 , SendState(s,r,n,old,old_offer,old_response,closing)
 , !Stored(s,r,succ(n),'9',~rev,<n,parent,old,root,offer,response,final,body>) ]

rule Receipt_Commit_0:
 let receipt = <body,sign(body,signer)>
     next_parent = h(<'completed-epoch',offer,response,final,receipt>)
     epoch = succ(n)
 in
 [ Receipt9(s,r,p,n,parent,old,offer,response,root,final,body,closing)[no_precomp]
 , SendState(s,r,n,old,old_offer,old_response,closing)[+,no_precomp]
 , !Signer(s,r,signer)[no_precomp], !Wrap(s,r,wrapping)[no_precomp], Fr(~rev) ]
 --[ Confirmed(s,r,epoch,root,next_parent), EpochInstalled(s,r,epoch,root)
   , ReadyState(s,r,epoch,root,next_parent), Saved(s,r,epoch,~rev,'0')
   , CounterState(s,r,epoch,'zero') ]->
 [ Ready(s,r,epoch,next_parent,root,r)
 , SendState(s,r,epoch,root,offer,response,'zero'), SendPermit(s,r)
 , !ApplicationEpoch(s,epoch)
 , !Stored(s,r,epoch,'0',~rev,<epoch,next_parent,root,offer,response,final,receipt>), Out(receipt) ]

rule Receipt_Accept_0:
 let core = <'receipt',scope(s,context,n,succ(n),r,parent),h(offer),h(response),h(final),peer_closing>
     body = <core,tag>
     receipt = <body,sig>
     next_parent = h(<'completed-epoch',offer,response,final,receipt>)
     epoch = succ(n)
 in
 [ Final8(s,p,r,n,parent,offer,response,root,final)[no_precomp], !Context(s,context)[no_precomp]
 , !Pinned(s,r,vk)[no_precomp], !Wrap(s,p,wrapping)[no_precomp], In(receipt), Fr(~rev) ]
 --[ Eq(verify(sig,body,vk),true), Eq(tag,h(<'receipt-confirmation',root,core>))
   , Confirmed(s,p,epoch,root,next_parent), ReadyState(s,p,epoch,root,next_parent)
   , Saved(s,p,epoch,~rev,'0') ]->
 [ Ready(s,p,epoch,next_parent,root,r)
 , !Stored(s,p,epoch,'0',~rev,<epoch,next_parent,root,offer,response,final,receipt>) ]

/* Sending uses one current epoch per device and is fenced during the two
   closing-signature reservations. Initial traffic is deliberately not modeled.
   The per-message key below abstracts the concrete chain/nonce construction. */
rule Application_Message:
 let traffic = h(<'traffic',s,context,epoch,role,root,h(<'traffic-transcript',offer,response>)>)
     key = h(<'message-key',traffic,counter>)
 in
 [ SendState(s,role,epoch,root,offer,response,counter)[+,no_precomp], SendPermit(s,role)[no_precomp]
 , !ApplicationEpoch(s,epoch)[no_precomp], !Context(s,context)[no_precomp], Fr(~payload) ]
 --[ Message(s,epoch,role,key,~payload), TrafficInput(s,epoch,role,root,key), CounterState(s,role,epoch,succ(counter)) ]->
 [ SendState(s,role,epoch,root,offer,response,succ(counter)), SendPermit(s,role)
 , Out(<s,epoch,role,counter,senc(~payload,key)>) ]

restriction Equality:
 "All x y #i. Eq(x,y)@i ==> x = y"

/* Independent certificates establish these structural properties without
   earlier reusable premises. They do not establish root secrecy or agreement. */
lemma ready_root_is_initial_or_hashed:
 "All s role epoch root parent #ready.
    ReadyState(s,role,epoch,root,parent)@ready
    ==> (epoch = 'zero') | (Ex material. root = h(material))"

lemma produced_state_role_and_epoch_have_public_constructors [use_induction]:
 "All s role epoch counter #produced.
    CounterState(s,role,epoch,counter)@produced
    ==> ((role = 'A') | (role = 'B'))
      & ((epoch = 'zero') | (Ex previous. epoch = succ(previous)))"

/* The two counter-constructor properties have complete checked proofs.
   The bare declarations carry no reusable assumptions; the captured joint
   certificate retains and checks the full dependency proof explicitly. */
lemma produced_counter_has_public_constructor [use_induction]:
 "All s role epoch counter #produced.
    CounterState(s,role,epoch,counter)@produced
    ==> counter = 'zero' | (Ex previous. counter = succ(previous))"

lemma application_counter_has_public_constructor [use_induction]:
 "All s epoch role root counter context offer response payload #sent.
    Message(s,epoch,role,
      h(<'message-key',
         h(<'traffic',s,context,epoch,role,root,h(<'traffic-transcript',offer,response>)>),
         counter>),payload)@sent
    ==> counter = 'zero' | (Ex previous. counter = succ(previous))"

/* Additional derivation-origin obligation; this remains unproved. */
lemma epoch_generation_secret_derivation_origin [use_induction]:
 "All s epoch key #created #known.
    GenerationSecret(s,epoch,key)@created & KU(key)@known
    ==> (Ex #leaked. EntropyLeak(s,epoch,'generation')@leaked)
      | (Ex role #captured. CapturedPhase(s,role,epoch,'1')@captured)
      | (Ex role #captured. CapturedPhase(s,role,epoch,'2')@captured)
      | (Ex role #captured. CapturedPhase(s,role,epoch,'3')@captured)"

lemma two_rounds_recover_with_exposed_ancestor_is_executable:
 exists-trace
 "Ex s sa sb root1 parent1 root2 parent2 revision key payload
       #setup #b1 #snap #c #learn #g2 #e2 #a2 #b2 #m.
    SessionKeys(s,sa,sb)@setup & not (sa = sb)
  & Confirmed(s,'B',succ('zero'),root1,parent1)@b1
  & Snapshot(s,'B',succ('zero'),revision)@snap
  & CapturedPhase(s,'B',succ('zero'),'0')@snap
  & Cut(s)@c & K(root1)@learn & b1 < snap & snap < c & c < learn & learn < m
  & KeyReserved(s,succ(succ('zero')),'B')@g2
  & RootBefore(s,'B',succ(succ('zero')),root1,parent1)@g2
  & EncapReserved(s,succ(succ('zero')),'A')@e2
  & RootBefore(s,'A',succ(succ('zero')),root1,parent1)@e2
  & c < g2 & c < e2
  & Confirmed(s,'A',succ(succ('zero')),root2,parent2)@a2
  & Confirmed(s,'B',succ(succ('zero')),root2,parent2)@b2
  & Message(s,succ(succ('zero')),'A',key,payload)@m & a2 < m & b2 < m
  & (All any_session role epoch any_revision #x. Snapshot(any_session,role,epoch,any_revision)@x
       ==> any_session = s & role = 'B' & epoch = succ('zero') & any_revision = revision & #x = #snap)
  & not (Ex any_session role #x. IdentityLeak(any_session,role)@x)
  & not (Ex any_session epoch kind #x. EntropyLeak(any_session,epoch,kind)@x)"

lemma delayed_receipt_exposes_pre_cut_epoch_two_reservation:
 exists-trace
 "Ex s sa sb root1 parent1 root2 parent2 revision key payload
       #setup #b1 #g2 #snap #c #a1 #e2 #a2 #b2 #m #known.
    SessionKeys(s,sa,sb)@setup & not (sa = sb)
  & Confirmed(s,'B',succ('zero'),root1,parent1)@b1
  & KeyReserved(s,succ(succ('zero')),'B')@g2
  & RootBefore(s,'B',succ(succ('zero')),root1,parent1)@g2
  & Snapshot(s,'B',succ(succ('zero')),revision)@snap
  & CapturedPhase(s,'B',succ(succ('zero')),'3')@snap
  & Cut(s)@c & b1 < g2 & g2 < snap & snap < c
  & Confirmed(s,'A',succ('zero'),root1,parent1)@a1 & c < a1
  & EncapReserved(s,succ(succ('zero')),'A')@e2
  & RootBefore(s,'A',succ(succ('zero')),root1,parent1)@e2 & c < e2
  & Confirmed(s,'A',succ(succ('zero')),root2,parent2)@a2
  & Confirmed(s,'B',succ(succ('zero')),root2,parent2)@b2
  & Message(s,succ(succ('zero')),'A',key,payload)@m & a2 < m & b2 < m
  & K(payload)@known & m < known
  & (All any_session role epoch any_revision #x. Snapshot(any_session,role,epoch,any_revision)@x
       ==> any_session = s & role = 'B' & epoch = succ(succ('zero')) & any_revision = revision & #x = #snap)
  & not (Ex any_session role #x. IdentityLeak(any_session,role)@x)
  & not (Ex any_session epoch kind #x. EntropyLeak(any_session,epoch,kind)@x)"

lemma reservations_inherit_locally_confirmed_root [use_induction]:
 "All s role epoch root parent #reserved.
    RootBefore(s,role,epoch,root,parent)@reserved
    ==> (Ex n #ready. epoch = succ(n) & ReadyState(s,role,n,root,parent)@ready & ready < reserved)"

/* Proposed unbounded-epoch property: all future captures of this session's
   post-Cut writes are excluded, not merely captures labelled with one epoch.
   This statement is unproved. Earlier/future round entropy disclosure remains
   allowed; only the selected recovery round's entropy is excluded. */
lemma multi_epoch_fresh_reservations_recover_symbolic_message_secrecy:
 "All s sa sb epoch proposer responder role key payload #setup #c #g #e #m.
    SessionKeys(s,sa,sb)@setup & Cut(s)@c
  & KeyReserved(s,epoch,proposer)@g & EncapReserved(s,epoch,responder)@e
  & Message(s,epoch,role,key,payload)@m & c < g & c < e
  & not (Ex #x. IdentityKeyLeak(sa)@x)
  & not (Ex #x. IdentityKeyLeak(sb)@x)
  & not (Ex kind #x. EntropyLeak(s,epoch,kind)@x)
  & not (Ex captured_role captured_epoch revision phase #saved #seen.
       Saved(s,captured_role,captured_epoch,revision,phase)@saved
     & Snapshot(s,captured_role,captured_epoch,revision)@seen & c < saved)
  ==> not (Ex #x. K(payload)@x)"

end
