  "scope": "Initial native managed account-root replacement owner, preserving original registry/enrollment/journal and independently approved witness operation.",
  "behavior": [
    "Preparing retains the original enrollment lease and revokes prior registry traffic.",
    "Signed freeze binds the exact original plan; the same parent transfers to restricted journal recovery.",
    "Signed retirement persists in child and parent before registry successor selection.",
    "Original receipt replay preserves revision 2 across restart and uncertain returns.",
    "Exact successor still requires current policy/credential, real signed witness admission and durable registry binding.",
    "Close/drop revokes registry access before disposing database owners; returned successor authority cannot outlive the controller."
  ],
