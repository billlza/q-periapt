  "dispositions": [
    {
      "alert": 700,
      "classification": "false positive for hard-coded key at the two named journal cipher sinks",
      "flow_join": "The reported path crosses policy admission, the containing service/journal owner, and its independent key field. It does not establish an assignment from the boolean to JournalKey bytes.",
      "required_behavior": "Keep enablement/current-policy refusal checks; removing them or randomizing the boolean would not fix a key source.",
      "sarif_index": 789,
      "sink": "Both seal and unseal_image initialize XChaCha20Poly1305 from key.0.as_bytes() of their separately supplied JournalKey. Active retains that key, and seal_next_image borrows it. The C consumer loads wrap.key before activation and passes that owner through installation/journal constructors.",
      "source": "Runtime::is_enabled returns Result<bool> from a Configuration variant match. PolicyPin::verify and VerifiedSessionPolicy::check_mode use it as a refusal condition and retain the original runtime/historical policy; check_mode returns Result<()> rather than key bytes."
    },
    {
      "alert": 537,
      "classification": "false positive for hard-coded nonce/key at all five named sinks",
      "key_sinks": "The same two JournalKey-backed cipher constructors as alert700 remain separate from policy metadata. Fresh key creation fills all 32 bytes before publication; reopen/decode copies the exact retained 32-byte key payload and propagates shape/read errors.",
      "nonce_sinks": "InitiationPlan::reserve and ResponsePlan::reserve use bootstrap::nonce(), which fills a separate 32-byte array through getrandom and propagates failure. Their private decode functions restore that distinct nonce field from the authenticated durable plan. The three reported prefix calls borrow self.nonce, not the SDK policy binding.",
      "required_behavior": "Keep deterministic policy identity, complete overwrite, entropy-error propagation and authenticated exact replay. Rejecting zero bytes in this public metadata or regenerating nonce during recovery would change the intended contract.",
      "sarif_index": 792,
      "sealed_operation_boundary": "The policy binding occupies an authenticated wire header. RecoveryKey::reserve independently fills operation entropy and a 24-byte AEAD nonce; open validates the exact binding and authenticates the ciphertext before returning entropy. Neither converts the binding into a bootstrap nonce or journal key.",
      "source": "Runtime::policy_binding initializes 68 bytes, then overwrites all 32 root-digest bytes and all 36 encoded trusted-policy-state bytes before return. It is intentionally public deterministic application-policy identity, not secret material or entropy."
    }
  ],
