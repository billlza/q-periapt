  "root_cause": "Default BufferedWriter sinks retain small subprocess-output chunks in user-space until a buffer fills or the file closes. A flushed child pipe therefore did not imply visibility in the retained log file.",
  "change": "Use exclusive unbuffered binary file handles for stdout and stderr in run_queries and ProfileRun.command; retain the existing bounded capture and context-manager lifetime.",
  "regression_protocol": {
    "children": "Two actual CPython subprocesses, one through each production logging entry point.",
    "writes": "Each child writes 12 bytes to stdout and 12 bytes to stderr and flushes both pipes.",
    "live_read": "Before exiting, each child polls the parent log files for both exact byte strings and verifies that the final parent receipt does not yet exist. It records success only after those checks.",
    "poll_bound_seconds": 5,
    "supervisor_bound_seconds": 10
  },
  "validation": {
