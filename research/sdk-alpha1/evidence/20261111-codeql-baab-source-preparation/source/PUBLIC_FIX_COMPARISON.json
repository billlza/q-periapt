za/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"billlza","id":149552943,"node_id":"U_kgDOCOn_Lw","avatar_url":"https://avatars.githubusercontent.com/u/149552943?v=4","gravatar_id":"","url":"https://api.github.com/users/billlza","html_url":"https://github.com/billlza","followers_url":"https://api.github.com/users/billlza/followers","following_url":"https://api.github.com/users/billlza/following{/other_user}","gists_url":"https://api.github.com/users/billlza/gists{/gist_id}","starred_url":"https://api.github.com/users/billlza/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/billlza/subscriptions","organizations_url":"https://api.github.com/users/billlza/orgs","repos_url":"https://api.github.com/users/billlza/repos","events_url":"https://api.github.com/users/billlza/events{/privacy}","received_events_url":"https://api.github.com/users/billlza/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"5e4819004450a43423c19818c65fe89779899eb6","url":"https://api.github.com/repos/billlza/q-periapt/commits/5e4819004450a43423c19818c65fe89779899eb6","html_url":"https://github.com/billlza/q-periapt/commit/5e4819004450a43423c19818c65fe89779899eb6"}]}],"files":[{"sha":"82699d8b906390a49c3c87674bdd288ef972641d","filename":"artifact/codeql_fixture_baab.py","status":"modified","additions":28,"deletions":10,"changes":38,"blob_url":"https://github.com/billlza/q-periapt/blob/95ba31c114fd9b0c3bc014ed9e37d416a577715f/artifact%2Fcodeql_fixture_baab.py","raw_url":"https://github.com/billlza/q-periapt/raw/95ba31c114fd9b0c3bc014ed9e37d416a577715f/artifact%2Fcodeql_fixture_baab.py","contents_url":"https://api.github.com/repos/billlza/q-periapt/contents/artifact%2Fcodeql_fixture_baab.py?ref=95ba31c114fd9b0c3bc014ed9e37d416a577715f","patch":"@@ -49,24 +49,42 @@ def prepare_sources(run):\n     run.command(\"pair-fetch\", [\"/usr/bin/git\", \"-C\", str(DIAGNOSTIC), \"fetch\",\n                 \"--no-tags\", \"--depth=1\", \"origin\", *[item[0] for item in SOURCES.values()]],\n                 seconds=180)\n-    records = {}\n-    for side, (commit, manifest, _) in SOURCES.items():\n-        destination = root / \"sources\" / side\n-        destination.mkdir()\n-        archive = root / \"sources\" / (side + \".tar\")\n-        run.command(\"pair-archive-\" + side, [\"/usr/bin/git\", \"-C\", str(DIAGNOSTIC),\n-                    \"archive\", \"--format=tar\", \"--output=\" + str(archive), commit, \"artifact\"])\n+    trees, attribute_blobs = {}, set()\n+    for side, (commit, _, _) in SOURCES.items():\n         listing = run.command(\"pair-tree-\" + side, [\"/usr/bin/git\", \"-C\", str(DIAGNOSTIC),\n-                              \"ls-tree\", \"-rz\", commit, \"artifact\"])\n+                              \"ls-tree\", \"-rz\", commit, \"artifact\", \".gitattributes\"])\n         entries = {}\n         for item in listing.rstrip(b\"\\0\").split(b\"\\0\"):\n             header, path = item.split(b\"\\t\", 1)\n             mode, kind, digest = header.decode().split()\n             name = path.decode()\n             require(mode in (\"100644\", \"100755\") and kind == \"blob\"\n-                    and name.startswith(\"artifact/\") and name not in entries,\n-                    \"source snapshot contains a nonregular or duplicate member\")\n+                    and len(digest) == 40 and set(digest) <= set(\"0123456789abcdef\")\n+                    and name not in entries, \"source snapshot contains an unadmitted member\")\n+            if name == \".gitattributes\":\n+                attribute_blobs.add(digest)\n+                continue\n+            require(name.startswith(\"artifact/\") and \"..\" not in Path(name).parts\n+                    and Path(name).as_posix() == name, \"source snapshot path differs\")\n             entries[name] = {\"mode\": mode, \"git_blob\": digest}\n+        trees[side] = entries\n+    # Prefetch every source blob. Archiving the fixed subtree limits Git's\n+    # temporary index to it, avoiding dependencies on other repository objects.\n+    blob_oids = sorted(attribute_blobs | {item[\"git_blob\"] for entries in trees.values()\n+                                        for item in entries.values()})\n+    run.command(\"pair-prefetch\", [\"/usr/bin/git\", \"-C\", str(DIAGNOSTIC),\n+                \"-c\", \"fetch.negotiationAlgorithm=noop\", \"fetch\", \"--no-tags\",\n+                \"--no-write-fetch-head\", \"--recurse-submodules=no\", \"--filter=blob:none\",\n+                \"origin\", *blob_oids], seconds=180)\n+    records = {}\n+    for side, (commit, manifest, _) in SOURCES.items():\n+        entries = trees[side]\n+        destination = root / \"sources\" / side\n+        destination.mkdir()\n+        archive = root / \"sources\" / (side + \".tar\")\n+        run.command(\"pair-archive-\" + side, [\"/usr/bin/git\", \"-C\", str(DIAGNOSTIC),\n+                    \"archive\", \"--format=tar\", \"--prefix=artifact/\",\n+                    \"--output=\" + str(archive), commit + \":artifact\"])\n         run.command(\"pair-unpack-\" + side, [\"/usr/bin/tar\", \"--extract\", \"--file=\" + str(archive),\n                     \"--no-same-owner\", \"--directory=\" + str(destination)])\n         files = inventory(destination)"}]}
