      "test": "managed_root_bad_receipts_preserve_unrelated_registry_authority",
      "before": "An invalid freeze signature closed the owning registry and revoked an unrelated application lease.",
      "after": "Receipt verification precedes the mutation path; invalid freeze and retirement preserve unrelated authority and the original operation."
    },
    {
      "capture": "closed-next-red-02",
      "prototype_source": "closed-next-red-source.rs",
      "test": "managed_root_closed_next_target_requires_another_independent_approval",
      "before": "The first transition prototype accepted replay to an already closed next plan.",
      "after": "Known closed next plans are rejected before mutation; another approved plan can complete the original root cutover."
    }
  ],
