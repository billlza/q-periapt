{
  "advisory": {
    "affected": "rustix >=1.0.0, <1.1.6, the six xattr Buffer functions",
    "classification": "unsound; undefined behavior reachable through the safe Buffer API with a zero-length output buffer",
    "file_sha256": "a034fc3af7556e9d78d973d959c661757e66f5f3b7063fffbc1b2564cf8c3bcd",
    "git_blob_sha1": "771621348de211646db0157792e6d23637b28581",
