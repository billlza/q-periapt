+pub(in crate::durable) fn study_input_records(
+    old: &Image,
+    new: &Image,
+    session: &[u8; 32],
+    offer: &[u8],
+) -> Result<(u8, usize), DurableError> {
+    let id = record_id(session);
+    let prior = old.records.get(&id).ok_or(DurableError::Absent)?;
+    let target = new.records.get(&id).ok_or(DurableError::Absent)?;
+    let before = State::decode(&prior.payload)?;
+    let mut after = State::decode(&target.payload)?;
+    if before.control.plan.is_some() {
+        return Err(DurableError::Conflict);
+    }
+    let mut control = Zeroizing::new(Vec::new());
+    after.control.encode(&mut *control);
+    let mut prefix = Zeroizing::new(Vec::new());
+    before.control.encode(&mut *prefix);
+    if prefix.pop() != Some(0) {
+        return Err(DurableError::Corrupt);
+    }
+    let suffix = control
+        .strip_prefix(prefix.as_slice())
+        .ok_or(DurableError::Corrupt)?;
+    let (phase, rest) = suffix.split_first().ok_or(DurableError::Corrupt)?;
+    let extra = rest.strip_prefix(offer).ok_or(DurableError::Corrupt)?;
+    match (*phase, extra.len()) {
+        (4, 245) => {
+            q_periapt_sdk::expert::replay::SealedOperation::from_bytes(extra)
+                .map_err(Error::from)?;
+        }
+        (10, 0) => (),
+        _ => return Err(DurableError::Corrupt),
+    }
+    after.control.plan = None;
+    if after.encode()?.as_slice() != prior.payload.as_slice() {
+        return Err(DurableError::Conflict);
+    }
+    Ok((*phase, extra.len()))
