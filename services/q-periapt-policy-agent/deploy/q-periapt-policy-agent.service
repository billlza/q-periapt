# Hardened systemd unit for the Q-Periapt policy-agent reference daemon.
#
# This unit is the Linux OS-level isolation contract for `serve-agent`. The
# daemon itself enforces only filesystem-capability and cryptographic
# boundaries; every kernel-level restriction below is enforced by the service
# manager, so a deployment that starts the binary any other way does not get
# these guarantees. Install the binary at /opt/qperiapt/bin, provision the
# 0700 service/configuration directories for the dedicated account first, and
# adjust the socket, repository, witness, and authority endpoints per host.
#
# The unit assumes a locked, non-login `qperiapt-agent` system account whose
# primary group is not shared with any other service:
#   useradd --system --shell /usr/sbin/nologin --home /var/lib/qperiapt-agent \
#     --user-group qperiapt-agent

[Unit]
Description=Q-Periapt policy agent (ABI 2 reference service)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=qperiapt-agent
Group=qperiapt-agent
# The witness and authority endpoints are deployment-provided; see the required
# drop-in below. They are NOT hardcoded to localhost, because the deployment
# contract requires hosting them outside this host's rollback/restore domain.
EnvironmentFile=/etc/qperiapt-agent/endpoints.conf
ExecStart=/opt/qperiapt/bin/q-periapt-policy-agent serve-agent \
    /var/lib/qperiapt-agent/service \
    /var/lib/qperiapt-agent/state/agent.redb \
    ${QPERIAPT_WITNESS_ENDPOINT} \
    ${QPERIAPT_AUTHORITY_ENDPOINT} \
    /var/lib/qperiapt-agent/config
Restart=no

# Secrets hygiene: no core dumps, no new privileges, owner-only umask.
LimitCORE=0
NoNewPrivileges=yes
UMask=0077

# Filesystem isolation: read-only OS, private /tmp and /dev, no home access;
# only the service state tree is writable.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/qperiapt-agent

# Kernel and process isolation.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=

# Network: the Unix IPC socket plus the TCP witness/authority clients only.
#
# Deny-by-default is deliberate and stays. What this unit does NOT do is ship a
# localhost allowance, because that silently contradicts the deployment
# contract: README.md requires the witness and the instance-lease authority to
# live outside this host's rollback/restore domain, and `IPAddressAllow=localhost`
# makes exactly that configuration unreachable. Shipping both would let an
# operator believe the rollback protection holds while the unit forbids the only
# topology that provides it.
#
# The deployment MUST supply a drop-in that allows precisely the endpoints it
# configured, and nothing wider. See the worked example in
# q-periapt-policy-agent.service.d/10-endpoints.conf.example. Choosing to run
# the witness and authority on this host behind a protected local relay is a
# valid decision, but it is an explicit decision that voids the rollback claim
# and must be recorded as such -- not the accidental default.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any

# Syscall filter: the service-manager-enforced seccomp boundary.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
