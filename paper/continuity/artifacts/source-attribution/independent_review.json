  "claims": [
    {
      "id": "lemma_A",
      "status": "accepted",
      "statement": "Stable executed original sources in an authoritative local history and epoch."
    },
    {
      "id": "proposition_B",
      "status": "accepted",
      "statement": "Eligible attribution failure implies an exposure-stopped fresh-body verification or distinct-input hash collision."
    },
    {
      "id": "proposition_C",
      "status": "accepted",
      "statement": "Exact reservation-aware ML-DSA and classical native deterministic P-256 component adapters for the declared owner interface; explicit U single-user factor."
    },
    {
      "id": "proposition_D",
      "status": "accepted",
      "statement": "Exact success-preserving ordinary-game reductions and generic original-coin-disclosure separation."
    }
  ],
  "resolved_findings": [
    "Exposure-stopped fresh-message event and exact prefix coupling",
    "Private eager ML-DSA Open calls counted before record serialization",
    "Causal source association separated from primitive correctness",
    "Actual deterministic RFC6979/low-s P-256 signing distribution",
    "Indexed multiuser games with explicit U single-user factor",
    "Actual-key all-purpose private-issuance ledger and exact owner aliases",
    "Original tuple controller distinguished from raw hashed binding API",
    "Simulation overhead counted for separation reductions"
  ],
  "remaining_instantiation_questions": [
    "A further reduction of the declared reservation-aware ML-DSA assumption to a conventional signature game",
    "A separate correspondence cost only if the owner-file observation interface is enlarged"
  ],
