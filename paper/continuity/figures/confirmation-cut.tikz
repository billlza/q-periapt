\begin{tikzpicture}[x=1cm,y=0.85cm,font=\small,>=Latex]
\node[font=\bfseries] at (0,0.5) {$A$};
\node[font=\bfseries] at (9.2,0.5) {$B$};
\draw[gray] (0,0.1)--(0,-6.2);
\draw[gray] (9.2,0.1)--(9.2,-6.2);
\draw[->] (0,0)--node[above] {Final for epoch 1}(9.2,0);
\node[align=left,anchor=west] at (9.35,-0.55) {};
\draw[<- ,dashed] (2.1,-1.05)--node[above] {Receipt 1 held in transit}(9.2,-1.05);
\node[align=center,fill=white] at (4.6,-2.0)
 {$B$ prepares epoch 2; capture $R_1$ and its generation reservation\\
  $c_A=0,\ c_B=1$};
\draw[densely dotted] (-0.4,-2.55)--(9.6,-2.55);
\node[anchor=west] at (9.65,-2.55) {Cut};
\draw[<-] (0,-3.15)--node[above] {Deliver receipt 1 and offer 2}(9.2,-3.15);
\draw[->] (0,-4.0)--node[above] {Fresh epoch-two encapsulation at $A$}(9.2,-4.0);
\draw[<->] (0,-4.85)--node[above] {Finish epoch 2 and restart}(9.2,-4.85);
\draw[<->,thick] (0,-5.7)--node[above] {Six application messages; all reconstructed}(9.2,-5.7);
